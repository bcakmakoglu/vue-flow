{
  "compilerOptions": {
    // typedoc 0.28 runs under TS 6, which errors on the deprecated `baseUrl` (still needed by the `~/*`
    // paths alias below) and `moduleResolution: "node"`. This config only feeds typedoc's type analysis,
    // so silence the deprecation rather than change how modules resolve (keeps the generated API stable).
    "ignoreDeprecations": "6.0",
    "incremental": false,
    "target": "es2017",
    "lib": [
      "DOM",
      "ESNext"
    ],
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "node",
    "paths": {
      "~/*": ["../packages/core/src/*"]
    },
    "resolveJsonModule": true,
    "types": [],
    "strict": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "../packages/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
