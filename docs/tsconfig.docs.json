{
  "compilerOptions": {
    "incremental": false,
    "target": "es2017",
    "lib": [
      "DOM",
      "ESNext"
    ],
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "node",
    "paths": {
      "~/*": ["../packages/core/src/*"]
    },
    "resolveJsonModule": true,
    "types": [],
    "strict": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "../packages/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
