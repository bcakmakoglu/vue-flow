{
  "name": "@vue-flow/core",
  "version": "1.48.2",
  "private": false,
  "author": "Burak Cakmakoglu<78412429+bcakmakoglu@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://vueflow.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bcakmakoglu/vue-flow.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/bcakmakoglu/vue-flow/issues"
  },
  "keywords": [
    "vue",
    "flow",
    "diagram",
    "editor",
    "graph",
    "node",
    "link",
    "port",
    "slot",
    "vue3",
    "composition-api",
    "vue-flow",
    "vueflow",
    "typescript"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.mjs"
    },
    "./dist/style.css": "./dist/style.css",
    "./dist/base.css": "./dist/base.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "shx rm -rf dist && pnpm theme && tsdown",
    "build:watch": "tsdown --watch",
    "theme": "postcss src/styles/style.css -o dist/style.css && postcss src/styles/base.css -o dist/base.css",
    "lint": "eslint .",
    "prepublishOnly": "shx cp ../../README.md .",
    "postpublish": "shx rm README.md",
    "test": "exit 0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "@xyflow/system": "^0.0.77"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.3",
    "@tooling/eslint-config": "workspace:*",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.0",
    "postcss-nested": "^7.0.2",
    "publint": "^0.3.21",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "unplugin-vue": "^7.2.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.4"
  }
}
